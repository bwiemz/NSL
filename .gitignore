/.serena
/target/
# Review-agent scratch target dirs (swept into a commit once — 6.2GB)
/target-review/
# Unanchored too: tools/tokbench is its own cargo workspace and its target/
# directory is hundreds of megabytes.
target/
.nsl-cache/
/.VSCodeCounter/
*.exe
*.o
# `examples/m6_features.nsl` writes this into the CURRENT directory as part of
# its file-I/O demo, and the e2e harness runs every example from the repo root.
# It was committed once (as were five examples/*.exe, before the rule above).
/test_m6.txt
.worktrees/
desktop.ini

# Spec and plan docs (tracked locally, not in repo)
docs/superpowers/specs/
docs/superpowers/plans/
docs/plans/

# Coder-RL generated data (rebuild with build_tokenizer.py + prepare_sft.py)
models/coder-rl/data/sft_tokens.bin
models/coder-rl/data/sft_labels.bin
models/coder-rl/data/tokenizer/
models/coder-rl/checkpoints/

# Coder-50m generated data
models/coder50m/data/*.bin
models/coder50m/data/tokenizer/

# Training checkpoints written by `train(checkpoint_save=...)`. `*.nslm` alone
# was enough until item 8 (PR #516) added the `.optim` sidecar next to it —
# which does NOT end in `.nslm`, so a run left the whole checkpoints/ directory
# untracked-but-not-ignored. At 500M that sidecar is 4 GB (m and v for 218
# params), and this repo has already lost work to `git add -A` sweeping up
# test artifacts.
# Ignore the CONTENTS but keep the directory: `train(checkpoint_save=...)`
# writes into a relative `checkpoints/` and does not create it, so a fresh
# clone that follows the recipe header must find it already there. coder50m
# already carried a tracked .gitkeep for exactly this reason.
*.nslm.optim
models/coder50m/checkpoints/*
!models/coder50m/checkpoints/.gitkeep
models/coder500m/checkpoints/*
!models/coder500m/checkpoints/.gitkeep
models/coder1b/checkpoints/*
!models/coder1b/checkpoints/.gitkeep

# Compiled NSL build artifacts (regenerated from .nsl sources)
*.exp
*.lib
*.nslm

# Test-generated profiling manifests (written by `nsl run --monitor`; contain
# absolute local paths and are regenerated on each test run).
*.nsl-profile.json

# Model binaries (regenerated from training)
*.onnx
*.safetensors
# Exception: committed CPDT calibration fixtures (deterministic, seed-anchored).
!tests/fixtures/cpdt_calibration/*.safetensors
# Exception: committed WGGO merge-gate fixtures (deterministic, seed-anchored).
!tests/fixtures/wggo_calib_data.safetensors
!tests/fixtures/wggo_calib_weights.safetensors
# Exception: committed CPDT multi-tier FP16 optimizer fixture weights (deterministic).
!crates/nsl-codegen/tests/fixtures/cpdt_precision_fp16_weights.safetensors

# Log files (per-run, never versioned)
*.log

# Insta snapshot pending-review files (accepted snapshots land as .snap)
*.snap.new

# Python bytecode
__pycache__/

# Research PDFs are versioned under docs/research/

# Claude Code / MCP plugin state
.claude/
.dist/
.playwright-mcp/

# Tokenizer evaluation corpus (regenerate with tools/build_tokenizer_corpus.py)
/data/

# MFU benchmark scratch (regenerated by models/benchmarks/mfu_bench.py)
models/*/mfu_generated.nsl
models/*/*_probe.nsl
kernel_profile.json
memory_profile.json
profile.json
models/benchmarks/srbf16_logs/
