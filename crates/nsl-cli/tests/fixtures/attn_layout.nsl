# attn_layout.nsl — fixture for attn_layout_gate.rs
#
# Two pre-norm blocks (RMSNorm -> grouped-query attention with RoPE ->
# residual -> RMSNorm -> SwiGLU -> residual) under a weight-tied LM head,
# trained a few updates. The gate compiles it with ATTN = the stdlib's
# GroupedQueryAttention (whose head views reach the attention without a copy:
# RoPE and the tensor-core attention keep the [b, s, h, d] layout) and with
# ATTN = PrevGqa below, the stdlib's forward as it was before (V's head view
# copied contiguous), run with that layout switched off. The two models have
# the same fields in the same order, so `--seed` initialises them alike.
#
# NH query heads of 64 over NKV key/value heads; DROP is the attention's
# output dropout. The gate substitutes all three.

from nsl.nn.norms import RMSNorm
from nsl.nn.gqa import GroupedQueryAttention
from nsl.nn.rope import RotaryEmbedding
from nsl.nn.losses import cross_entropy

model PrevGqa(d_model: int, n_heads: int, n_kv_heads: int, head_dim: int, dropout_p: float, max_seq_len: int, rope_theta: float, n_layers: int):
    _d_model: Tensor = full([1], float(d_model))
    _n_heads: Tensor = full([1], float(n_heads))
    _n_kv_heads: Tensor = full([1], float(n_kv_heads))
    _head_dim: Tensor = full([1], float(head_dim))
    _n_rep: Tensor = full([1], float(n_heads // n_kv_heads))
    _dropout_p: Tensor = full([1], dropout_p)
    wq: Tensor = randn([d_model, n_heads * head_dim]) * sqrt(full([1], 2.0 / float(d_model + n_heads * head_dim)))
    wk: Tensor = randn([d_model, n_kv_heads * head_dim]) * sqrt(full([1], 2.0 / float(d_model + n_kv_heads * head_dim)))
    wv: Tensor = randn([d_model, n_kv_heads * head_dim]) * sqrt(full([1], 2.0 / float(d_model + n_kv_heads * head_dim)))
    wo: Tensor = randn([n_heads * head_dim, d_model]) * sqrt(full([1], 2.0 / float(n_heads * head_dim + d_model))) * full([1], 1.0 / sqrt(full([1], float(2 * n_layers))).item())
    rope: RotaryEmbedding = RotaryEmbedding(head_dim, max_seq_len, rope_theta)

    fn forward(self, x: Tensor, training: bool) -> Tensor:
        let s = x.shape
        let batch = s[0]
        let seq_len = s[1]
        let nh = int(self._n_heads.item())
        let nkv = int(self._n_kv_heads.item())
        let hd = int(self._head_dim.item())
        let dp = self._dropout_p.item()
        let q = x @ self.wq
        let k = x @ self.wk
        let v = x @ self.wv
        let q4 = q.reshape([batch, seq_len, nh, hd]).transpose(1, 2)
        let k4 = k.reshape([batch, seq_len, nkv, hd]).transpose(1, 2)
        let v4 = v.reshape([batch, seq_len, nkv, hd]).transpose(1, 2)
        let q_rope = self.rope.forward(q4, seq_len)
        let k_rope = self.rope.forward(k4, seq_len)
        let v_c = v4.contiguous()
        let scale = 1.0 / sqrt(float(hd))
        let attn_out = scaled_dot_product_attention(q_rope, k_rope, v_c, scale, true)
        let attn_t = attn_out.transpose(1, 2)
        let attn_flat = attn_t.reshape([batch, seq_len, nh * hd])
        let out = attn_flat @ self.wo
        return dropout(out, dp, training)

model Block:
    attn_norm: RMSNorm = RMSNorm(256)
    attn: ATTN = ATTN(256, NH, NKV, 64, DROP, 128, 10000.0, 2)
    ffn_norm: RMSNorm = RMSNorm(256)
    w_gate: Tensor = randn([256, 512]) * full([1], 0.05)
    w_up: Tensor = randn([256, 512]) * full([1], 0.05)
    w_down: Tensor = randn([512, 256]) * full([1], 0.03)

    fn forward(self, x: Tensor, training: bool) -> Tensor:
        let h = x + self.attn.forward(self.attn_norm.forward(x), training)
        let n = self.ffn_norm.forward(h)
        return h + (silu(n @ self.w_gate) * (n @ self.w_up)) @ self.w_down

model Probe:
    embed: Tensor = randn([128, 256]) * full([1], 0.02)
    blocks: [Block; 2] = Block()
    norm: RMSNorm = RMSNorm(256)

    fn forward_train(self, input_ids: Tensor, training: bool) -> Tensor:
        let sh = input_ids.shape
        let b = sh[0]
        let s = sh[1]
        let emb = embedding_lookup(self.embed, input_ids.reshape([b * s]))
        let x = emb.reshape([b, s, 256])
        for block in self.blocks:
            x = block.forward(x, training)
        x = self.norm.forward(x)
        return x @ self.embed.transpose(0, 1)

let m = Probe()
# GPU_PLACEMENT

# 8 micro-batches of 2 x 128 tokens, 4 optimizer updates.
let unit = arange(128)
let tokens = unit.reshape([1, 128]).expand([16, 128]).contiguous().reshape([2048])
let loader = DataLoader(tokens, batch_size=2, seq_len=128, shuffle=false, drop_last=true)

print("LOSS_STREAM_BEGIN")

train(model=m, epochs=1, grad_accumulation=2):
    optimizer: AdamW(lr=0.01, weight_decay=0.0, beta1=0.9, beta2=0.95, eps=1e-8)
    step(batch):
        let logits = m.forward_train(batch.input_ids, true)
        let ls = logits.shape
        let flat_logits = logits.reshape([ls[0] * ls[1], ls[2]])
        let flat_labels = batch.labels.reshape([ls[0] * ls[1]])
        let loss = cross_entropy(flat_logits, flat_labels)
    callbacks:
        on_step(step, loss):
            print(loss)

print("LOSS_STREAM_END")
print("WEIGHTS_BEGIN")
print(m.blocks[0].attn.wq.sum())
print(m.blocks[0].attn.wk.sum())
print(m.blocks[1].attn.wv.sum())
print(m.blocks[1].attn.wo.sum())
print(m.embed.sum())
print("WEIGHTS_END")
