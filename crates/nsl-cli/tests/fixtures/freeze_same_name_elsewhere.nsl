# A binding-scoped @freeze reaches the model ITS `let` bound, not every
# variable of that name (see freeze_decorator_gate.rs). The first `net` is
# frozen and trained; a second `let net` rebinds the name to another `Two`,
# with the same field names, and both of its weights train.
from nsl.nn.losses import mse_loss

model Two:
    w1: Tensor = randn([4, 4]) * 0.3
    w2: Tensor = randn([4, 4]) * 0.3

    fn forward(self, x: Tensor) -> Tensor:
        return (x @ self.w1) @ self.w2

let x = (arange(12).reshape([3, 4])) * 0.1 + full([3, 4], 0.1)
let y = (arange(12).reshape([3, 4])) * 0.2 - full([3, 4], 1.0)

@freeze(include=["w1"])
let net = Two()
train(model = net, epochs = 1):
    optimizer: SGD(lr = 0.1)
    step(batch):
        let loss = mse_loss(net.forward(x), y)

let net = Two()
let w1_0: Tensor = net.w1
let w2_0: Tensor = net.w2
print("W1_0_BEGIN")
print(w1_0)
print("W1_0_END")
print("W2_0_BEGIN")
print(w2_0)
print("W2_0_END")
train(model = net, epochs = 4):
    optimizer: SGD(lr = 0.1)
    step(batch):
        let loss = mse_loss(net.forward(x), y)
let w1: Tensor = net.w1
let w2: Tensor = net.w2
print("W1_BEGIN")
print(w1)
print("W1_END")
print("W2_BEGIN")
print(w2)
print("W2_END")
