# CFIE speculative serve with a DRAFT MODEL COMPILED INTO THE BINARY.
#
# What this adds over examples/cfie_serve_generate.nsl:
#   * `draft_weights:` names a second (smaller) checkpoint that serve
#     init loads and binds NEXT TO the target model (same CUDA context,
#     same process): nsl_model_create(draft) ->
#     nsl_cfie_bind_draft_model -> nsl_cfie_draft_pool_alloc.
#   * The compiler emits two extra kernels: the draft decode block (the
#     decode-block emitter instantiated with the draft dims) and the
#     draft greedy sampler (argmax over the draft's LM head).
#   * The endpoint's generate() compiles to
#     nsl_cfie_speculative_generate: per round the draft proposes K
#     tokens greedily; the target is then stepped through the same
#     positions and its own sampler (the sampling: settings below, the
#     same per-position draws as plain decoding) draws each token. A
#     drawn token that equals the drafted one confirms the next drafted
#     input; the first that differs ends the round.
#
# WHAT TO EXPECT:
#   * OUTPUT: exactly the tokens plain generate() gives for the same
#     seed. Every token is drawn by the target; the draft only predicts
#     it. (For a greedy draft this is the speculative-sampling rule:
#     accept the drafted token with the target's probability of it, else
#     draw from the target with that token removed.)
#   * SPEED: slower than plain decoding. Each round makes K draft steps
#     and up to K target steps, one target step per emitted token, so
#     the draft is pure extra work. Speculation pays only when the target
#     scores the K positions in one batched pass, which this engine does
#     not have. The build report says the same.
#
# BOUNDARIES:
#   * Drafting is method "standard" (a linear K-token chain), greedy.
#     tree/medusa/lookahead, tree_width and a draft temperature are
#     compile errors.
#   * The draft shares the target's vocab — bind refuses on a mismatch.
#   * draft_* shape keys default to the target's dims when omitted; a
#     wrong shape refuses loudly at serve init when the checkpoint's
#     weights are validated.
#
# Running needs a CUDA build + GPU + real checkpoints at both paths;
# compiling never needs a GPU.

serve Inference:
    max_batch: 32
    max_seq: 2048
    kv_layout: "static"
    kv_quant: "uniform_fp16"
    target_gpu: "h100"

    # TARGET model architecture (compile-time plan + bind shapes).
    n_layers: 8
    n_kv_heads: 4
    head_dim: 128
    d_model: 512
    d_ff: 1408
    vocab_size: 49152

    weights: "model.safetensors"
    tokenizer: "tokenizer.json"
    prompt: "The capital of France is"
    max_new_tokens: 32
    eos_token_id: 2

    sampling:
        temperature: 0.7
        top_k: 50
        top_p: 0.9
        fused: true

    speculative:
        tokens: 4
        method: "standard"
        # The draft model compiled into this binary (G15).
        draft_weights: "draft.safetensors"
        draft_n_layers: 2
        draft_d_model: 256
        draft_n_heads: 2
        draft_n_kv_heads: 1
        draft_head_dim: 128
        draft_d_ff: 704

    @endpoint
    fn complete(prompt: str) -> str:
        # With a speculative: section this drives the SPECULATIVE decode
        # loop (nsl_cfie_speculative_generate, K = tokens); without one,
        # the plain nsl_cfie_generate — same syntax, same tokens.
        let count = generate("Inference", prompt, 0)
        print(count)
