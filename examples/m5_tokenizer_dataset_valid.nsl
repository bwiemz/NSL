tokenizer demo_tokenizer(algorithm=bpe, vocab_size=1024):
    special_tokens:
        pad = "<pad>"
        eos = "<eos>"

    normalize: nfkc, lowercase
    pre_tokenize: whitespace, byte_fallback

    padding:
        side = left
        pad_to = longest

    truncation:
        max_length = 128
        strategy = longest_first

# A dataset block declares packing statistics for attention planning. It
# loads no data: that is load_mmap(...) and DataLoader(...).
dataset train_data("demo"):
    packing = true
    max_sequence_length = 128
    mean_doc_length = 32

print("ok")