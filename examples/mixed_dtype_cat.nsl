# Regression: tensor_cat over inputs from different producers.
#
# This once mixed f32 creation results with f64 ones (arange), and tensor_cat
# converted the rest into the first input's dtype. Every creation is f32 now
# (C5 step 3), and a cat of mixed dtypes is refused (step 4).

let a = full([2], 1.5)
let b = arange(0.0, 3.0)
let ab = tensor_cat([a, b], -1)
let expected = tensor_cat([full([2], 1.5), full([1], 0.0), full([1], 1.0), full([1], 2.0)], -1)
assert_close(ab, expected, 0.0001, 0.0001)

# Reverse order.
let ba = tensor_cat([b, a], -1)
assert_close(ba.select(-1, -1), full([1], 1.5).select(-1, -1), 0.0001, 0.0001)

print("mixed-dtype-cat-ok")
