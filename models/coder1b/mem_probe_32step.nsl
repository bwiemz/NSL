# models/coder1b/mem_probe_32step.nsl
# ============================================================================
# 32-micro-step memory probe — the fast proxy for the 1B allocator peak
# ============================================================================
# A trimmed copy of pretrain_prod.nsl (validation tail removed, corpus cut to
# 131,072 tokens = 32 micro-steps at batch 2 x seq 2048). Its allocator peak
# reproduces the FULL-EPOCH production peak TO THE BYTE (22,073,520,640 B
# measured both ways, 2026-08-24), because the peak is at end-of-forward of an
# early step, not anywhere the epoch's length can reach. That makes memory
# work on this model a minutes-loop instead of an hours-loop.
#
# Corpus: head -c 262144 data/tokens/prod_train_slice.bin > \
#           data/tokens/mem_probe_32step.bin
# Run (from this directory):
#   NSL_MEMSTATS=1 nsl run --source-ad --checkpoint-blocks \
#     --fuse-rmsnorm-backward [--optim-state-offload] mem_probe_32step.nsl
# Numbers and the segment-early-free measurements:
#   models/benchmarks/SEGMENT_EARLY_FREE_2026_08_24.md
# Paths (`from model import ...` are relative to it):
#   python models/benchmarks/make_prod_split.py     # once
#   cd models/coder1b
#   nsl run --source-ad --checkpoint-blocks --fuse-rmsnorm-backward \
#           --optim-state-offload pretrain_prod.nsl
#
# THE FLAGS ARE NOT ALL THE SAME KIND OF THING, and an earlier draft of this
# header flattened them into "every flag is required", which is false:
#
#   --source-ad             the production path. The fused LCE and SDPA
#                           kernels exist only there.
#   --optim-state-offload   REQUIRED, measured. Without it this configuration
#                           OOMs; see below.
#   --checkpoint-blocks     REQUIRED, measured. Activation recomputation.
#                           Dropping it OOMs at step 0 (`Requested 67108864`,
#                           `VRAM free: 252.2 MB / 31.39 GB`, allocation #1296,
#                           sum_dim_f32) — as hard a requirement as the offload
#                           below. Stated inline rather than behind a reference,
#                           because a reader skimming this table otherwise
#                           concludes exactly one flag is load-bearing.
#   --fuse-rmsnorm-backward NOT a memory requirement — dropping it leaves the
#                           run surviving, with a driver-peak difference below
#                           what that quantity can even resolve (19 MiB raw and
#                           3 MiB net, in OPPOSITE directions, against a
#                           ~1548 MiB run-to-run spread). `nsl build --help`
#                           calls it an "opt-in speedup" that "matches the
#                           decomposition to an f32 tolerance" (the fused paths
#                           are bit-deterministic run-to-run, but they are not
#                           bit-equal to the unfused decomposition). It is in
#                           the recommended line because it is free at this
#                           scale, not because the run needs it. Drop it if you
#                           want the reference backward.
#
# Dropping `--optim-state-offload` exhausts VRAM on a 32 GB card. Measured
# twice, and the run does not fail the same way both times: it first DEGRADES
# ("[nsl] GPU OOM in <op> — falling back to CPU", which does not stop the run,
# it just makes 1B unusably slow), and then aborts outright at a later
# allocation ("VRAM free: 182.8 MB / 31.39 GB", allocation #1199, nsl_mul_f32).
# The second probe reached only the fallback stage inside its time budget, so
# treat the allocation number and op name as ONE INSTANCE, not a signature —
# what reproduces is the cause, not the crash site. That cause is measured
# identically in both runs: f32 AdamW at 1.07B parameters puts 16.02 GiB of
# PERSISTENT state on the device before a single activation is stored —
# weights 4.02 + optim_m 4.00 + optim_v 4.00 + m_partial 4.00, all four visible
# in the `[gpu-mem] surfaces:` line at step 0 — and the stored activations of
# 16 layers at batch 2 x seq 2048 do not fit in what is left.
# Host-resident moments move all
# three optimizer surfaces off the device and leave weights 4.02 GiB against a
# 16.54 GiB activation peak, for an allocator peak of 20.56 GiB, on an RTX PRO
# 4500 Blackwell (32 GB, 31.39 usable). Units are GiB throughout: the
# allocator's memstats lines say "MB" and its OOM dump says "GB", and both
# divide by 1024. See PROD1B_VALIDATION_2026_08_19.md EC1 for the full-run
# driver-level peak (which is higher, and is the number to size a card
# against) and for the alternatives that were measured and rejected.
#
# WHY NOT `--layerwise-accum`, which Milestone B's benchmark uses: it REFUSES
# grad_clip ("two-phase clipping needs the GLOBAL L2 norm over every
# parameter's completed m_partial before any update, which the layerwise
# schedule never materializes"). At 500M the failure mode this recipe family
# actually hits is a loss excursion, so trading gradient clipping away for
# memory the offload already buys is the wrong trade for a PRODUCTION run.
# `nsl check --training-report` prints `two_phase_clip: true` for this file,
# and the agreement gate asserts it — the clip is planned, not merely written
# down in a kwarg the flag set silently dropped.
#
# Source AD is the production path (fused LCE/SDPA only exist there).

from model import NSLCoder
from nsl.nn.losses import cross_entropy

let m = NSLCoder()
m.to(cuda)
print("================================================================")
print("  NSL-Coder-1B production pretrain")
print("  49152 vocab | batch=2 seq=2048 accum=4 | 1 epoch = 2048 steps")
print("================================================================")

# SHUFFLE IS ON — on general grounds, NOT on a measured improvement. A
# concatenated corpus (this repo, then 15 unrelated projects) should not be
# presented to the optimizer in file order, and item 8 (PR #516) made a seeded
# shuffle reproducible and resumable, which it was not before: the single-rank
# path drew its permutation from ENTROPY, so shuffling would have made every
# run's data order irreproducible and every checkpoint's recorded position
# meaningless. At 500M shuffling did not improve held-out loss (9.765
# sequential vs 9.793 shuffled); it was not re-measured at 1B.
let tokens = load_mmap("../../data/tokens/mem_probe_32step.bin", 3)
let loader = DataLoader(tokens, batch_size=2, seq_len=2048, shuffle=true, drop_last=true)

print("LOSS_STREAM_BEGIN")

# The fused linear-CE kernel computes the loss straight from the hidden state
# and the LM-head weight, so the [batch*seq, vocab] logits surface and its
# gradient are never materialized — at 1B@2048 that surface would be
# 2*2048*49152*4 B = 768 MiB live, twice. The four hints must be INT LITERALS
# matching model.nsl / the DataLoader; a wrong one is refused at runtime by
# `nsl_fused_lce_pin_hint_extents`. The reshape below must use the same
# compile-time dims (a runtime `logits.shape` read keeps the composite chain
# live and the compiler refuses the fusion) — which is why this step body does
# NOT use the `let ls = logits.shape` spelling that pretrain_1b2048.nsl, whose
# fusion is requested by flag instead, is free to use.
#
# `enabled = true` REFUSES a head the fusion cannot match, with one exception:
# if source-AD extraction of the step body fails outright, codegen WARNS —
# "[fused-lm-ce] ... it will NOT run and the full [batch*seq, vocab] logits
# gradient will be materialized" — and falls back to tape, because that path
# has a legitimate reading. At 1B that fallback is a 768 MiB surface plus its
# gradient and the run will not fit. The BUILD IS STILL GREEN in that case, so
# the agreement gate cannot catch it; the detectors are that stderr warning,
# the absence of a `[fused-lce] forward route=` line, and the PEAK_* block
# below.
@fused_lm_ce(enabled=true, vocab_size=49152, hidden_size=2048, batch_size=2, seq_len=2048)
train(model=m, epochs=1, grad_accumulation=4, grad_clip=1.0, checkpoint_save="checkpoints/pretrain_prod_state.nslm", checkpoint_every=100):
    optimizer: AdamW(lr=0.0001, weight_decay=0.1, beta1=0.9, beta2=0.95, eps=1e-8)
    scheduler: warmup_cosine(warmup_steps=200, total_steps=2048, min_lr=0.00003)
    step(batch):
        let logits = m.forward_train(batch.input_ids, true)
        let flat_logits = logits.reshape([4096, 49152])
        let flat_labels = batch.labels.reshape([4096])
        let loss = cross_entropy(flat_logits, flat_labels)
    callbacks:
        on_step(step, loss):
            if step % 20 == 0:
                print(step)
                print(loss)

print("LOSS_STREAM_END")

# ── the run states its own memory posture ────────────────────────────────
# The at-peak decomposition, not the step-boundary [gpu-mem] sample: those
# print where the activation surface is 0, and reading one as "the peak" is a
# mistake this repo has made twice. Surfaces: 1 weights, 2 optim_m, 3 optim_v,
# 4 m_partial, 6 activations. Under --optim-state-offload, 2/3/4 must read 0
# at the peak — that is the whole reason this configuration fits, and a silent
# regression to device-resident moments would otherwise only show up as an OOM
# on someone else's card.
print("PEAK_BYTES")
print(gpu_peak_bytes())
print("PEAK_WEIGHTS")
print(gpu_surface_at_peak_bytes(1))
print("PEAK_OPTIM_M")
print(gpu_surface_at_peak_bytes(2))
print("PEAK_OPTIM_V")
print(gpu_surface_at_peak_bytes(3))
print("PEAK_M_PARTIAL")
print(gpu_surface_at_peak_bytes(4))
print("PEAK_ACTIVATIONS")
print(gpu_surface_at_peak_bytes(6))

print("MEM_PROBE_COMPLETE")
