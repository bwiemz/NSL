# models/coder1b/pilot_lr3e5.nsl
# ============================================================================
# NSL-Coder-1B corpus-v2 LR ARM — peak 3e-5, the matched pair to the pilot
# ============================================================================
#
# The pilot (PILOT1B_VALIDATION_2026_08_25.md) descended through warmup and
# then held ZERO slope for 21,600 micro-steps at peak lr 1e-4: learning
# happened while the ramp held lr LOW and stopped at full lr, which makes a
# LOWER peak the informative next arm. This file is pretrain_pilot.nsl with
# exactly two numbers changed — peak lr 1e-4 -> 3e-5, min_lr scaled by the
# same 0.3 ratio (3e-5 -> 9e-6) so the cosine SHAPE matches — and its own
# checkpoint/save paths. Same data file, same seeded shuffle (same
# permutation => the two arms see IDENTICAL batches in identical order:
# a matched-pair differential, the strongest cheap design). Same flags:
#   nsl run --source-ad --checkpoint-blocks --fuse-rmsnorm-backward \
#           pilot_lr3e5.nsl
# Val loops stay UNSTAGED (probe-verified correct; loader ids are i32 and
# embedding_lookup takes them host-resident by design).

from model import NSLCoder
from nsl.nn.losses import cross_entropy

let m = NSLCoder()
m.to(cuda)

print("================================================================")
print("  NSL-Coder-1B corpus-v2 LR ARM: peak lr 3e-5, matched pair vs 1e-4")
print("================================================================")

let tokens = load_mmap("../../data/tokens/pilot_train_98m.bin", 3)
let loader = DataLoader(tokens, batch_size=2, seq_len=2048, shuffle=true, drop_last=true)

print("LOSS_STREAM_BEGIN")

@fused_lm_ce(enabled=true, vocab_size=49152, hidden_size=2048, batch_size=2, seq_len=2048)
train(model=m, epochs=1, grad_accumulation=4, grad_clip=1.0, checkpoint_save="checkpoints/pilot_lr3e5_state.nslm", checkpoint_every=500):
    optimizer: AdamW(lr=0.00003, weight_decay=0.1, beta1=0.9, beta2=0.95, eps=1e-8)
    scheduler: warmup_cosine(warmup_steps=2400, total_steps=24000, min_lr=0.000009)
    step(batch):
        let logits = m.forward_train(batch.input_ids, true)
        let flat_logits = logits.reshape([4096, 49152])
        let flat_labels = batch.labels.reshape([4096])
        let loss = cross_entropy(flat_logits, flat_labels)
    callbacks:
        on_step(step, loss):
            if step % 80 == 0:
                print(step)
                print(loss)

print("LOSS_STREAM_END")

print("PEAK_BYTES")
print(gpu_peak_bytes())
print("PEAK_WEIGHTS")
print(gpu_surface_at_peak_bytes(1))
print("PEAK_OPTIM_M")
print(gpu_surface_at_peak_bytes(2))
print("PEAK_OPTIM_V")
print(gpu_surface_at_peak_bytes(3))
print("PEAK_M_PARTIAL")
print(gpu_surface_at_peak_bytes(4))
print("PEAK_ACTIVATIONS")
print(gpu_surface_at_peak_bytes(6))

let sval_tokens = load_mmap("../../data/tokens/pilot_val_stack_2m.bin", 3)
let sval_loader = DataLoader(sval_tokens, batch_size=2, seq_len=2048, shuffle=false, drop_last=true)

let sval_total = 0.0
let sval_count = 0.0
for batch in sval_loader:
    let vlogits = m.forward_train(batch.input_ids, false)
    let vs = vlogits.shape
    let vflat_logits = vlogits.reshape([vs[0] * vs[1], vs[2]])
    let vflat_labels = batch.labels.reshape([vs[0] * vs[1]])
    let vloss = cross_entropy(vflat_logits, vflat_labels)
    sval_total = sval_total + vloss.item()
    sval_count = sval_count + 1.0

print("VAL_LOSS_STACK")
print(sval_total / sval_count)
print("VAL_BATCHES_STACK")
print(sval_count)

let wval_tokens = load_mmap("../../data/tokens/pilot_val_web_2m.bin", 3)
let wval_loader = DataLoader(wval_tokens, batch_size=2, seq_len=2048, shuffle=false, drop_last=true)

let wval_total = 0.0
let wval_count = 0.0
for batch in wval_loader:
    let wlogits = m.forward_train(batch.input_ids, false)
    let ws = wlogits.shape
    let wflat_logits = wlogits.reshape([ws[0] * ws[1], ws[2]])
    let wflat_labels = batch.labels.reshape([ws[0] * ws[1]])
    let wloss = cross_entropy(wflat_logits, wflat_labels)
    wval_total = wval_total + wloss.item()
    wval_count = wval_count + 1.0

print("VAL_LOSS_WEB")
print(wval_total / wval_count)
print("VAL_BATCHES_WEB")
print(wval_count)

model_save(m, "checkpoints/pilot_lr3e5_final.nslm")
print("PILOT_LR3E5_COMPLETE")
