# models/coder500m/config.nsl
# NSL-Coder-500M Configuration
#
# Scaled from coder50m (48.8M) by widening d_model 512→1280 and deepening
# n_layers 8→24.  Same GQA / SwiGLU / RoPE architecture — only hyperparams
# change.  Target: ~505M params for a FASE peak-memory demo on consumer
# GPUs (16GB VRAM).

# Architecture
const VOCAB_SIZE = 49152
const D_MODEL = 1280
const N_LAYERS = 24
const N_HEADS = 20
const N_KV_HEADS = 10
const HEAD_DIM = 64
const D_FF = 3520
const MAX_SEQ_LEN = 1024
const ROPE_THETA = 10000.0
const DROPOUT = 0.1

# Pretrain hyperparameters — MUST agree with pretrain_prod.nsl; enforced by
# crates/nsl-cli/tests/pretrain_prod_agreement_gate.rs, which checks every
# model size (three since item 10; coder1b reads these same two slices at a
# 4096-token delivery slot rather than 2048). The scheduler numbers are
# DERIVED from the real corpus:
#   PRETRAIN_TOTAL_STEPS = PRETRAIN_EPOCHS
#                        * floor(TRAIN_TOKENS / (MAX_SEQ_LEN * PRETRAIN_BATCH_SIZE))
#
# (Roadmap item 9. The previous 305000/3000 pair described a corpus this
# repo has never contained — the same fiction item 4 removed from the 50M
# config. `PRETRAIN_GRAD_ACCUM` was also renamed to the 50M spelling
# `PRETRAIN_GRAD_ACCUMULATION` so ONE gate covers every size; nothing
# imported the old name.)
#
# TOKEN BUDGET, stated plainly: 8.39M train tokens against ~505M params is
# ~0.017 tokens/param — a factor of ~1,200 short of a Chinchilla-ish ~20
# tokens/param. (Item 10 corrected this: it read "two orders of magnitude",
# which understates the gap by more than 10x and contradicted the 1B recipe's
# "HALF the 500M ratio".) This recipe validates the WORKFLOW at 500M — real
# corpus, real schedule,
# checkpoint/resume, held-out validation — it does not produce a
# well-trained 500M model, and VAL_LOSS is expected to part company with
# the training loss. Fixing that needs a corpus, which is roadmap item 15.
# LR AND WARMUP ARE MEASURED, not inherited. This repo carried lr = 3e-4
# unchanged across d_model 512 / 1280 / 2048; at 500M on this 512-optimizer-
# step schedule it is too high. Three full-epoch arms
# (models/benchmarks/PROD500M_VALIDATION_2026_08_19.md):
#   lr 3e-4, warmup 200, sequential : erratic, max loss 13.82, VAL 9.765
#   lr 3e-4, warmup 200, shuffled   : erratic, max loss 19.37, VAL 9.793
#   lr 1.5e-4, warmup 400, shuffled : MONOTONE 9.12 -> 7.44,   VAL 9.197
# 0.57 nats of held-out improvement, twenty times the 0.028 that separates the
# two shuffle arms.
const CORPUS_TOKENS = 8925916
const TRAIN_TOKENS = 8388608
const VAL_TOKENS = 524288
const PRETRAIN_LR = 0.00015
const PRETRAIN_WARMUP = 400
const PRETRAIN_TOTAL_STEPS = 4096
const PRETRAIN_MIN_LR = 0.00003
const PRETRAIN_BATCH_SIZE = 2
const PRETRAIN_GRAD_ACCUMULATION = 8
const PRETRAIN_WEIGHT_DECAY = 0.1
const PRETRAIN_BETA1 = 0.9
const PRETRAIN_BETA2 = 0.95
const PRETRAIN_EPOCHS = 1
const PRETRAIN_GRAD_CLIP = 1.0
const PRETRAIN_CHECKPOINT_EVERY = 100
# Shuffled: a concatenated corpus should not be fed in file order, and item 8
# made a seeded shuffle reproducible and resumable (it was entropy-keyed
# before). NOT measured to improve quality — see
# models/benchmarks/PROD500M_VALIDATION_2026_08_19.md EC3.
const PRETRAIN_SHUFFLE = 1

# Finetune hyperparameters
const FINETUNE_LR = 0.00001
const FINETUNE_WARMUP = 100
const FINETUNE_MIN_LR = 0.000001
const FINETUNE_BATCH_SIZE = 1
const FINETUNE_GRAD_ACCUM = 16
const FINETUNE_WEIGHT_DECAY = 0.1
const FINETUNE_BETA1 = 0.9
const FINETUNE_BETA2 = 0.95
const FINETUNE_EPOCHS = 1

# Inference
const TOP_K = 40
const TEMPERATURE = 0.8
const MAX_GEN_TOKENS = 512

# Paths (relative to this directory). The train/val slices are a byte-exact
# prefix/tail cut of the shared corpus, materialized by
# models/benchmarks/make_prod_split.py — the TAIL is held out, and the
# 13,020 tokens between TRAIN_TOKENS and the start of the val tail are
# consumed by neither. Disjointness is automatic — they are separate files —
# so the gap buys SEPARATION: in a concatenated corpus the tokens just past
# the training prefix usually continue the same file.
const PRETRAIN_CORPUS = "../../data/tokens/train_new.bin"
const PRETRAIN_DATA = "../../data/tokens/prod_train_slice.bin"
const PRETRAIN_VAL_DATA = "../../data/tokens/prod_val_slice.bin"
const CHECKPOINT_DIR = "checkpoints"

# Parameter budget (approximate, f32):
#   Embedding (tied LM head): 49152 × 1280 =  62.9M
#   Per TransformerBlock:
#     GQA (Q/K/V/O):          1280 × 3840 =   4.9M
#     SwiGLU (gate+up+down):  3 × (1280×3520) = 13.5M
#     Block total:                         ≈ 18.4M
#   24 blocks:                              ≈ 442M
#   Final RMSNorm:                          ≈ 0
#   TOTAL:                                  ≈ 505M
