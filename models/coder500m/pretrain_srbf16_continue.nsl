# models/coder500m/pretrain_srbf16_continue.nsl
#
# Item-16 reload-continuation arm: load the checkpoint the cert arm saved
# and keep training under the same bf16-sr stack. Certifies that a model
# whose authoritative weights lived in bf16 mirrors round-trips through
# .nslm and continues from the same loss level (no re-warmup spike).
#
# NOTE the optimizer state (m/v) is NOT in the checkpoint — continuation is
# a fresh-moment restart at the parent's final weights, so the comparison is
# "resumes at the parent's loss level and keeps improving", not bit-identity
# with an uninterrupted run.
#
# Harness markers (exact string rewrites):
#   CERT_TOKENS_PATH -> the u16 tokens.bin path
#   CERT_LOAD_PATH   -> the parent run's .nslm checkpoint
#   CERT_SAVE_PATH   -> where the continued model is saved

from model import NSLCoder
from nsl.nn.losses import cross_entropy

let m = NSLCoder()
model_load(m, "CERT_LOAD_PATH")
m.to(cuda)
print("CERT_MODEL_READY")

let tokens = load_mmap("CERT_TOKENS_PATH", 3)
let loader = DataLoader(tokens, batch_size=1, seq_len=512, shuffle=false, drop_last=true)

print("LOSS_STREAM_BEGIN")

train(model=m, epochs=1, grad_accumulation=8):
    optimizer: AdamW(lr=0.0003, weight_decay=0.1, beta1=0.9, beta2=0.95, eps=1e-8)
    step(batch):
        let logits = m.forward_train(batch.input_ids, true)
        let ls = logits.shape
        let flat_logits = logits.reshape([ls[0] * ls[1], ls[2]])
        let flat_labels = batch.labels.reshape([ls[0] * ls[1]])
        let loss = cross_entropy(flat_logits, flat_labels)
    callbacks:
        on_step(step, loss):
            print(step)
            print(loss)

print("LOSS_STREAM_END")
model_save(m, "CERT_SAVE_PATH")
print("CERT_COMPLETE")
