# models/coder50m/config.nsl
# NSL-Coder-50M Configuration

# Architecture
const VOCAB_SIZE = 49152
const D_MODEL = 512
const N_LAYERS = 8
const N_HEADS = 8
const N_KV_HEADS = 4
const HEAD_DIM = 64
const D_FF = 1408
const MAX_SEQ_LEN = 1024
const ROPE_THETA = 10000.0
const DROPOUT = 0.1

# Pretrain hyperparameters — MUST agree with pretrain_prod.nsl; enforced by
# crates/nsl-cli/tests/pretrain_prod_agreement_gate.rs. The scheduler
# numbers are DERIVED from the real corpus:
#   PRETRAIN_TOTAL_STEPS = PRETRAIN_EPOCHS * floor(CORPUS_TOKENS / MAX_SEQ_LEN)
# (scheduler steps are micro-batches; the old 305000 figure described a
# corpus this repo never contained.)
const CORPUS_TOKENS = 8925916
const PRETRAIN_LR = 0.0003
const PRETRAIN_WARMUP = 1300
const PRETRAIN_TOTAL_STEPS = 26148
const PRETRAIN_MIN_LR = 0.00003
const PRETRAIN_BATCH_SIZE = 1
const PRETRAIN_GRAD_ACCUMULATION = 8
const PRETRAIN_WEIGHT_DECAY = 0.1
const PRETRAIN_BETA1 = 0.9
const PRETRAIN_BETA2 = 0.95
const PRETRAIN_EPOCHS = 3
const PRETRAIN_GRAD_CLIP = 1.0
const PRETRAIN_CHECKPOINT_EVERY = 500

# Finetune hyperparameters
const FINETUNE_LR = 0.00001
const FINETUNE_WARMUP = 100
const FINETUNE_MIN_LR = 0.000001
const FINETUNE_BATCH_SIZE = 16
const FINETUNE_WEIGHT_DECAY = 0.1
const FINETUNE_BETA1 = 0.9
const FINETUNE_BETA2 = 0.95
const FINETUNE_EPOCHS = 2

# Inference
const TOP_K = 40
const TEMPERATURE = 0.8
const MAX_GEN_TOKENS = 512

# Paths (relative to working directory)
const PRETRAIN_DATA = "../../data/tokens/train_new.bin"
const FINETUNE_DATA = "data/finetune/mixed_tokens.bin"
const TOKENIZER_PATH = "data/tokenizer/codeforge.json"
const CHECKPOINT_DIR = "checkpoints"
