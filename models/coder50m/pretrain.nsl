# models/coder50m/pretrain.nsl
# ============================================================================
# NSL-Coder-50M — Stage 1 Pretraining
# ============================================================================

from model import NSLCoder
from nsl.nn.losses import cross_entropy

print("Initializing model...")
let m = NSLCoder()
print("Model created, transferring to GPU...")
m.to(cuda)
print("Model on GPU")
print("================================================================")
print("  NSL-Coder-50M Pretraining (GPU)")
print("  48.8M parameters | batch=1, seq=1024, AdamW")
print("================================================================")

let tokens = load_mmap("C:/Users/bwiem/ai testing/codeforge/data/pretokenized/150m/tokens.bin", 3)
let loader = DataLoader(tokens, batch_size=1, seq_len=1024, shuffle=false, drop_last=true)

print("Starting train block...")

# The fused linear-CE kernel computes the loss straight from the hidden
# state and the LM-head weight, so the [batch*seq, vocab] logits surface and
# its gradient are never materialized: measured here at batch 1 x seq 1024,
# activations peak 2665 MB -> 2185 MB and the step is ~5% faster (the saving
# scales with batch -- ~8% at batch 4, where the deleted surface is 4x
# larger).
#
# The four hints must be INT LITERALS matching model.nsl: vocab_size and
# hidden_size are VOCAB_SIZE / D_MODEL, batch_size and seq_len are the
# DataLoader's. Getting one wrong is refused at runtime by the pin in
# `nsl_fused_lce_pin_hint_extents`, which names the value to use.
#
# The flatten below must use those same compile-time dims. A runtime read of
# the logits (the `let ls = logits.shape` this used to open with) keeps the
# composite chain live, which defeats the fusion -- the compiler refuses it
# rather than silently falling back.
@fused_lm_ce(enabled=true, vocab_size=49152, hidden_size=512, batch_size=1, seq_len=1024)
train(model=m, epochs=1, grad_clip=1.0):
    optimizer: AdamW(lr=0.0003, weight_decay=0.1, beta1=0.9, beta2=0.95)
    scheduler: warmup_cosine(warmup_steps=3000, total_steps=10000, min_lr=0.00003)
    step(batch):
        let logits = m.forward_train(batch.input_ids, true)
        let flat_logits = logits.reshape([1024, 49152])
        let flat_labels = batch.labels.reshape([1024])
        let loss = cross_entropy(flat_logits, flat_labels)
    callbacks:
        on_step(step, loss):
            if step % 10 == 0:
                print(step)
                print(loss)

model_save(m, "checkpoints/coder50m_final.nslm")
print("Final checkpoint saved.")
print("================================================================")
