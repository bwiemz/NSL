## The dense building blocks: projection, embedding table, and the
## position-wise MLP.

## An affine projection: `y = x W^T + b`.
##
## `w` is `[out_features, in_features]` and transposed at use, matching
## the row-major LM-head convention used throughout the stdlib. It is
## initialised `N(0, 1/in_features)`, so a unit-variance input gives a
## unit-variance output and a stack of these neither explodes nor
## vanishes at depth; the bias starts at zero.
model Linear(in_features: int, out_features: int):
    w: Tensor = randn([out_features, in_features]) * sqrt(full([1], 1.0 / float(in_features)))
    b: Tensor = zeros([out_features])

    fn forward(self, x: Tensor) -> Tensor:
        return bias_add(x @ self.w.transpose(0, 1), self.b)

## A lookup table of `vocab_size` rows of width `embed_dim`, indexed by
## integer token ids. Rows are initialised `N(0, 0.02^2)`, the usual
## scale for token embeddings.
model Embedding(vocab_size: int, embed_dim: int):
    weight: Tensor = randn([vocab_size, embed_dim]) * full([1], 0.02)

    fn forward(self, indices: Tensor) -> Tensor:
        return embedding_lookup(self.weight, indices)

## Two-layer feed-forward block with a GELU between them — the
## transformer position-wise MLP. `hidden` is conventionally 4x
## `in_features`. Each weight is initialised `N(0, 1/fan_in)`.
model MLP(in_features: int, hidden: int, out_features: int):
    w1: Tensor = randn([hidden, in_features]) * sqrt(full([1], 1.0 / float(in_features)))
    b1: Tensor = zeros([hidden])
    w2: Tensor = randn([out_features, hidden]) * sqrt(full([1], 1.0 / float(hidden)))
    b2: Tensor = zeros([out_features])

    fn forward(self, x: Tensor) -> Tensor:
        let h = gelu(bias_add(x @ self.w1.transpose(0, 1), self.b1))
        return bias_add(h @ self.w2.transpose(0, 1), self.b2)
