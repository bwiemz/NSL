## Learned absolute position embeddings.

## Learned absolute position embeddings, added to the token embeddings.
## For rotary positions — what the GQA attention here uses — see
## `nsl.nn.rope`.
model PositionalEmbedding(max_seq: int, dim: int):
    pe: Tensor = randn([max_seq, dim])

    fn forward(self, x: Tensor) -> Tensor:
        let s = x.shape
        let seq_len = s[0]
        let pos = self.pe.slice(0, 0, seq_len)
        return x + pos
