## Rotary position embeddings.

# Rotary frequency table: `emb[p, :] = concat(p * inv_freq, p * inv_freq)`
# for p in [0, max_seq_len), i.e. the [max_seq_len, dim] argument that cos/sin
# are taken over.
#
# This is a FREE function, not a method, because model field initializers
# cannot reference sibling fields (`self.inv_freq` is not in scope while the
# struct is still being built) — so the cached tables below and `inv_freq`
# must each derive the frequencies from the constructor arguments. Keeping
# that derivation in one place is the point of the function.
## Build the `[max_seq_len, dim]` rotary frequency table that `cos`/`sin`
## are taken over: row `p` is `concat(p * inv_freq, p * inv_freq)`.
##
## A free function rather than a method because a model field
## initializer cannot reference a sibling field, and both cached tables
## plus `inv_freq` need the same derivation.
fn rope_freq_table(dim: int, max_seq_len: int, theta: float) -> Tensor:
    let inv_freq = exp(arange(0.0, float(dim), 2.0) * (-1.0 * log(theta) / float(dim)))
    let half_d = dim // 2
    let t2 = arange(0.0, float(max_seq_len)).reshape([max_seq_len, 1])
    let inv2 = inv_freq.reshape([1, half_d])
    let freqs = t2 @ inv2
    let tensors = [freqs, freqs]
    return tensor_cat(tensors, 1)

## Rotary position embeddings (RoPE), applied to Q and K.
##
## `cos`/`sin` are precomputed over the whole `[max_seq_len, dim]` grid
## at construction and gathered per call, rather than rebuilt on every
## attention layer. Consequently `seq_len` must not exceed
## `max_seq_len`: the bound is enforced at the gather, which aborts
## naming the offending index.
##
## The `_`-prefixed fields are derived constants, not parameters — the
## prefix keeps them out of the trainable set, so they take no gradient,
## no optimizer moments and no weight decay.
model RotaryEmbedding(dim: int, max_seq_len: int, theta: float):
    # Precompute inverse frequencies: theta^(-2i/d) for i in [0, dim/2)
    # Using exp(-log(theta) * indices / dim) since ** is scalar-only.
    # Still needed by forward_with_positions(), whose positions are per-token
    # and therefore not a prefix of the cached table.
    inv_freq: Tensor = exp(arange(0.0, float(dim), 2.0) * (-1.0 * log(theta) / float(dim)))
    _dim: Tensor = full([1], float(dim))
    _half_dim: Tensor = full([1], float(dim) / 2.0)

    # Cached cos/sin over the full [max_seq_len, dim] position grid, built
    # ONCE at construction. `forward` gathers the first `seq_len` rows instead
    # of rebuilding arange -> outer product -> cat -> cos/sin on every call —
    # that chain used to run twice per attention layer (Q and K), i.e. 2 *
    # n_layers times per model forward.
    #
    # The `_` prefix keeps these out of the trainable parameter set
    # (`is_trainable_param_leaf_name` in nsl-codegen), so they get no
    # gradient, no AdamW moments, and no weight decay — they are derived
    # constants, not weights.
    _cos_table: Tensor = tensor_cos(rope_freq_table(dim, max_seq_len, theta))
    _sin_table: Tensor = tensor_sin(rope_freq_table(dim, max_seq_len, theta))

    fn forward(self, x: Tensor, seq_len: int) -> Tensor:
        # x shape: [batch, heads, seq, head_dim]
        let d = int(self._dim.item())

        # Rows 0..seq_len of the cached tables. This is a row GATHER, not a
        # slice: `PrimalOp::Slice` bakes its bounds in as compile-time
        # constants, so a runtime `seq_len` cannot be expressed through it,
        # while `embedding_lookup` takes its indices as a runtime tensor and
        # is already a first-class source-AD op. Bit-exact with the former
        # recompute (verified: sum of squared differences == 0).
        #
        # `seq_len > max_seq_len` is now a real constraint — the old per-call
        # rebuild worked at any length. It is enforced by the host-resident
        # bounds check in `nsl_tensor_embedding_lookup`, which aborts naming
        # the offending index rather than reading past the table; there is no
        # separate `_max_seq_len` field because the table's own row count is
        # the authority. Gated by `rope_cache_gate::
        # sequence_longer_than_max_seq_len_refuses`.
        let pos = arange(0.0, float(seq_len))
        let cos_emb = embedding_lookup(self._cos_table, pos)
        let sin_emb = embedding_lookup(self._sin_table, pos)

        # Reshape for broadcasting: [1, 1, seq, dim]
        let cos_4d = cos_emb.reshape([1, 1, seq_len, d])
        let sin_4d = sin_emb.reshape([1, 1, seq_len, d])

        # Apply rotation: x * cos + rotate_half(x) * sin
        return x * cos_4d + rotate_half(x) * sin_4d

    # Packed-sequence variant: positions come from an explicit [batch, seq]
    # tensor instead of arange(seq_len), so packed batches can reset the
    # rotary position to 0 at each document start (the DataLoader emits
    # `position_ids` = index-within-document alongside `segment_ids`).
    #
    # position_ids is a non-differentiable leaf exactly as arange's output
    # is, and the cos/sin chain uses only cat/cos/sin/mul ops — no new AD
    # rules.
    #
    # This path deliberately still BUILDS the table per call rather than
    # gathering from `_cos_table`/`_sin_table` like `forward` does. A gather
    # would be valid arithmetic (position_ids are integer positions, so they
    # index the same table rows), but the packed path's op sequence is what
    # `pca_rope` / the segment-masked flash kernel selection match on, and
    # that selection is gated on GPU hardware this change was not measured
    # against. Left as-is on purpose; see the campaign notes.
    fn forward_with_positions(self, x: Tensor, position_ids: Tensor) -> Tensor:
        # x: [batch, heads, seq, head_dim]; position_ids: [batch, seq]
        let s = x.shape
        let batch = s[0]
        let seq_len = s[2]
        let half_d = int(self._half_dim.item())
        let d = int(self._dim.item())

        # Per-row outer product: freqs[b, seq, dim/2] = pos[b, :, None] * inv_freq[None, :]
        # (rank-3 @ rank-2 batched matmul — same idiom as the GQA projections).
        let p3 = position_ids.reshape([batch, seq_len, 1])
        let inv2 = self.inv_freq.reshape([1, half_d])
        let freqs = p3 @ inv2

        # Duplicate for full head_dim: [batch, seq, dim]
        let tensors = [freqs, freqs]
        let emb = tensor_cat(tensors, 2)

        let cos_emb = tensor_cos(emb)
        let sin_emb = tensor_sin(emb)

        # Per-row tables broadcast over heads: [batch, 1, seq, dim]
        let cos_4d = cos_emb.reshape([batch, 1, seq_len, d])
        let sin_4d = sin_emb.reshape([batch, 1, seq_len, d])

        return x * cos_4d + rotate_half(x) * sin_4d
